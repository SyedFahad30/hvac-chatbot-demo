# Copy this file to config-hvac.env and fill in real values.
# config-hvac.env is read by deploy-hvac.ps1 — never commit it (secrets).

# --- AWS ---
AWS_REGION=us-east-1
AWS_PROFILE=default

# --- Naming (safe to leave as-is; kept fully separate from the Lake America resources) ---
FUNCTION_NAME=hvac-chat-backend
ROLE_NAME=hvac-chat-lambda-role
TABLE_NAME=hvac-conversations
API_NAME=hvac-chat-api

# --- Anthropic ---
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- S3 (new-job intake Excel workbook) ---
# Bucket names must be globally unique across ALL of AWS.
S3_BUCKET=CHANGE-ME-globally-unique-bucket-name
S3_KEY=new-job-intake.xlsx

# --- Site hosting (for deploy-hvac-site.ps1) ---
SITE_BUCKET=CHANGE-ME-globally-unique-site-bucket-name

# --- CORS ---
ALLOWED_ORIGIN=*

# --- Twilio (missed-call text-back) ---
# Leave these blank until you have a Twilio account — the /voice and /sms
# routes will safely no-op (log a message, do nothing) without erroring.
# Get these from console.twilio.com after creating an account and buying
# a phone number.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
